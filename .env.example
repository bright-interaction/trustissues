# Trustissues configuration.
# The two secrets below are REQUIRED and the server refuses to boot with these
# placeholder values in place. Generate a real value for each:
#   openssl rand -hex 32
TRUSTISSUES_JWT_SECRET=REPLACE_ME_openssl_rand_hex_32
TRUSTISSUES_VAULT_KEY=REPLACE_ME_openssl_rand_hex_32

# Externally reachable URL of this instance (used for links and cookie scope).
TRUSTISSUES_BASE_URL=http://localhost:8080

# Interface the server binds to. Defaults to loopback so a bare-metal deploy is
# never reachable off-host by accident; terminate TLS in a reverse proxy
# (Caddy) in front. In Docker this is overridden to 0.0.0.0 (see Dockerfile),
# where the container network namespace provides the isolation.
TRUSTISSUES_BIND_HOST=127.0.0.1

# Number of trusted reverse-proxy hops in front of the server. The rate-limit
# client IP is derived by stripping this many trusted hops from the right of
# the X-Forwarded-For chain, so clients cannot spoof their way past limits.
# The intended deploy sits behind one Caddy.
TRUSTISSUES_TRUSTED_PROXY_HOPS=1

TRUSTISSUES_LOG_LEVEL=info
