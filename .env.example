# Trustissues configuration.
# The two secrets below are REQUIRED and the server refuses to boot with these
# placeholder values in place. Generate a real value for each:
#   openssl rand -hex 32
TRUSTISSUES_JWT_SECRET=REPLACE_ME_openssl_rand_hex_32
TRUSTISSUES_VAULT_KEY=REPLACE_ME_openssl_rand_hex_32

# ROTATING THE VAULT KEY. Set this to the OLD key, and only while a rotation is
# in flight. With it set, every decrypt tries the current key and then this one,
# so a store that has not been re-encrypted yet keeps serving instead of showing
# every secret as blank.
#
# The sequence, start to finish:
#   1. openssl rand -hex 32                          (the new key)
#   2. move the CURRENT value of TRUSTISSUES_VAULT_KEY into
#      TRUSTISSUES_VAULT_KEY_PREVIOUS, put the new value in TRUSTISSUES_VAULT_KEY
#   3. restart. The instance boots and serves normally, and both the boot log and
#      Settings -> Encryption say the store is still on the old key.
#   4. run the re-encrypt sweep: Settings -> Encryption -> "Re-encrypt
#      everything", or POST /api/admin/vault-key/rekey, or set
#      TRUSTISSUES_VAULT_KEY_REKEY_ON_BOOT=1 for a headless deploy.
#   5. confirm Settings -> Encryption reports everything on the current key.
#   6. REMOVE TRUSTISSUES_VAULT_KEY_PREVIOUS and restart. Until you do, the key
#      you are retiring is still loaded and still opens all of this data, which
#      defeats the point of rotating after a compromise.
#
# Do NOT leave this set permanently, and do NOT set it to the same value as
# TRUSTISSUES_VAULT_KEY (the server refuses that: it reads as a configured
# rotation while being a no-op). Every boot after the sweep warns until you
# remove it.
#
# A short or weak OLD key is accepted here (with a warning). It describes data
# that already exists, so refusing it would only block the rotation away from it,
# which is exactly the rotation such an instance needs.
# TRUSTISSUES_VAULT_KEY_PREVIOUS=

# Run the re-encrypt sweep once at startup, before the server accepts traffic.
# For headless deploys where nobody logs in to press the button. Requires
# TRUSTISSUES_VAULT_KEY_PREVIOUS. The server refuses to start if the sweep fails,
# because a green boot would tell you a rotation completed when it did not.
# Remove it (along with the previous key) once the rotation is done.
# TRUSTISSUES_VAULT_KEY_REKEY_ON_BOOT=0

# Externally reachable URL of this instance (used for links and cookie scope).
TRUSTISSUES_BASE_URL=http://localhost:8080

# Interface the server binds to. Defaults to loopback so a bare-metal deploy is
# never reachable off-host by accident; terminate TLS in a reverse proxy
# (Caddy) in front. In Docker this is overridden to 0.0.0.0 (see Dockerfile),
# where the container network namespace provides the isolation.
TRUSTISSUES_BIND_HOST=127.0.0.1

# Number of trusted reverse-proxy hops in front of the server. The rate-limit
# client IP is derived by stripping this many trusted hops from the right of
# the X-Forwarded-For chain, so clients cannot spoof their way past limits.
# The intended deploy sits behind one Caddy.
TRUSTISSUES_TRUSTED_PROXY_HOPS=1

TRUSTISSUES_LOG_LEVEL=info

# Shield (LLM-boundary tokenization). OPTIONAL. When set, PII crossing to an
# external model through the AI gateway or MCP boundary is tokenized and
# resolved server-side; unset means Shield is off (data passes through). The key
# is used directly as an AES-256 key, so it must be EXACTLY 32 bytes; a set-but-
# wrong-length key refuses to boot (fail-safe). Generate one with:
#   openssl rand -hex 16
# TRUSTISSUES_SHIELD_KEY=
# Hint level dials how much value-derived metadata a marker exposes to the model:
# full | bucketed | minimal | none (default full).
# TRUSTISSUES_SHIELD_HINT_LEVEL=full
