# /etc/trustissues/backup.env - configuration for the scheduled backup, the
# retention policy, the restore drill, and the failure alerter.
#
# Install this as root, mode 0600. It holds an SMTP password.
#   install -m 0600 -D backup.env.example /etc/trustissues/backup.env
#
# It does NOT hold TRUSTISSUES_VAULT_KEY and must never hold it. The whole
# reason the snapshots are safe at rest is that the key lives somewhere the
# backups do not. A key in this file, on the box that writes the backups, is the
# same as no encryption.

# ---------------------------------------------------------------- what to back up
# The directory that contains trustissues.db.
#   bare metal:  /opt/trustissues/data
#   compose:     /var/lib/docker/volumes/trustissues_trustissues_data/_data
#                (root-only; the unit runs as root by default for this reason)
TRUSTISSUES_DATA_DIR=/opt/trustissues/data

# ---------------------------------------------------------------- where to put it
# MUST NOT be inside TRUSTISSUES_DATA_DIR: backup.sh refuses that outright,
# because retention pruning would then be deleting inside the live data dir.
#
# SHOULD NOT be on the same filesystem either. backup.sh warns when it is. The
# database and its backups sharing a volume survives "I deleted a row" and
# nothing else: one full disk, one lost volume, one corrupt filesystem takes
# both at once. Point this at a separate disk, a mounted NAS, or a directory you
# replicate off the box.
#
# Avoid /home and /root: the units set ProtectHome=read-only.
TRUSTISSUES_BACKUP_DIR=/var/backups/trustissues

# ---------------------------------------------------------------- retention
# The newest snapshot of each of the last N distinct UTC days, plus the newest
# of each of the last M distinct 7-day blocks. The two overlap, so these
# defaults hold about ten files: a week of daily granularity and a month of
# coarse history. Raise the cadence in trustissues-backup.timer and these
# numbers together, never one alone.
TRUSTISSUES_BACKUP_KEEP_DAILY=7
TRUSTISSUES_BACKUP_KEEP_WEEKLY=4

# ---------------------------------------------------------------- restore drill
# Fail the weekly drill if the newest snapshot is older than this many hours.
# This is the check that catches a timer that stopped: without it the drill
# happily proves that a three month old file still restores and reports green.
# With a daily backup, 48 gives one missed night of slack. 0 disables the check.
TRUSTISSUES_DRILL_MAX_AGE_HOURS=48

# Optional. A row you know must be in every snapshot, checked after the restore.
# Left unset, the drill uses the oldest entry in the live vault (read-only), and
# falls back to the oldest entry in the snapshot itself. Set both or neither.
#TRUSTISSUES_DRILL_CANARY_SQL=SELECT count(*) FROM vault_entries WHERE id='the-id-you-know';
#TRUSTISSUES_DRILL_CANARY_EXPECT=1

# ---------------------------------------------------------------- alerting
# Where failures go. Both the backup unit and the drill unit page through
# trustissues-backup-alert@.service, which reads this same file.
#
# Leave any of these empty and the alerter exits 0 quietly, so an unconfigured
# host does not turn one failed backup into two failed units. That also means
# an empty value here is the same as NO ALERTING: send yourself a test with
# `./install.sh --test-alert` before believing it works.
ALERT_TO=ops@example.com
SMTP_FROM=trustissues@example.com
SMTP_HOST=smtp.example.com

# 587 (STARTTLS), not 465. The alerter forces the TLS upgrade with curl's
# --ssl-reqd, so 587 here is encrypted, not plaintext. Many providers, including
# the one this estate runs on, BLOCK outbound 465, and a send to 465 does not
# error, it hangs until the alerter's 60s timeout. If you must use 465, expect
# to prove it works with --test-alert first.
SMTP_PORT=587
SMTP_USER=trustissues@example.com
SMTP_PASS=changeme_smtp_password
